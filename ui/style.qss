/*
  ==========================
   GYM SaaS Professional UI
  ==========================
  Palette:
  Primary: #2F6BFF
  Neutral BG: #F4F7FB
  Surface: #FFFFFF
  Status: success #16A34A | warning #F59E0B | danger #DC2626
*/

QMainWindow,
QWidget#appRoot {
    background-color: #F4F7FB;
    color: #0F172A;
}

* {
    outline: none;
    font-family: "Cairo", "Tajawal", "Noto Naskh Arabic", "Segoe UI", sans-serif;
    font-size: 11pt;
}

/* Sidebar */
Sidebar#sidebar {
    background: #0B1220;
    border-radius: 18px;
    border: 1px solid #111B2E;
}

QLabel#brandTitle {
    color: #FFFFFF;
    font-size: 13pt;
    font-weight: 800;
    padding: 6px 4px;
}

QPushButton[class="navBtn"] {
    color: #CBD5E1;
    text-align: right;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 10px 12px;
    font-weight: 700;
}

QPushButton[class="navBtn"]:hover {
    background: #172338;
    color: #F8FAFC;
    border-color: #24334D;
}

QPushButton[class="navBtn"]:checked {
    background: #2F6BFF;
    color: #FFFFFF;
    border-color: #2F6BFF;
}

QLabel#mutedText {
    color: #64748B;
}

/* Top bar */
QFrame#topBar {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QLabel#systemName {
    font-size: 12pt;
    font-weight: 800;
    color: #0F172A;
}

QLineEdit#searchInput {
    background: #F8FAFC;
    border: 1px solid #D8E2EE;
    border-radius: 12px;
    padding: 9px 12px;
}

QLineEdit#searchInput:focus {
    border-color: #2F6BFF;
    background: #FFFFFF;
}

/******** Buttons ********/
QPushButton {
    background: #2F6BFF;
    color: #FFFFFF;
    border: none;
    border-radius: 11px;
    padding: 9px 14px;
    font-weight: 700;
}

QPushButton:hover {
    background: #2358D9;
}

QPushButton:pressed {
    background: #1D4AB6;
}

QPushButton#btnGhost,
QPushButton#tableIconBtn {
    background: #EEF2FF;
    color: #1E40AF;
}

QPushButton#btnGhost:hover,
QPushButton#tableIconBtn:hover {
    background: #E0E7FF;
}

QPushButton#tableDeleteBtn {
    background: #FEE2E2;
    color: #B91C1C;
}

QPushButton#tableDeleteBtn:hover {
    background: #FECACA;
}

QPushButton#tableIconBtn,
QPushButton#tableDeleteBtn {
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    border-radius: 9px;
    padding: 0;
}

/* Cards */
QFrame#card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QFrame#card[accent="primary"] { border-top: 4px solid #2F6BFF; }
QFrame#card[accent="warning"] { border-top: 4px solid #F59E0B; }
QFrame#card[accent="danger"] { border-top: 4px solid #DC2626; }

QLabel#cardTitle {
    color: #64748B;
    font-size: 10pt;
    font-weight: 700;
}

QLabel#cardValue {
    color: #0F172A;
    font-size: 21pt;
    font-weight: 800;
}

/* Panels */
QFrame#sectionPanel {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QLabel#sectionTitle {
    color: #0F172A;
    font-size: 11.5pt;
    font-weight: 800;
}

/* Inputs */
QComboBox,
QSpinBox,
QDateEdit,
QTextEdit,
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #D8E2EE;
    border-radius: 10px;
    padding: 8px 10px;
}

QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QTextEdit:focus,
QLineEdit:focus {
    border-color: #2F6BFF;
}

/* Tables */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #EEF2F7;
    alternate-background-color: #FAFCFF;
    selection-background-color: #DBEAFE;
    selection-color: #0F172A;
}

QHeaderView::section {
    background: #F8FAFC;
    color: #334155;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    padding: 10px;
    font-weight: 800;
}

QTableWidget::item {
    padding: 11px;
    border-bottom: 1px solid #F1F5F9;
}

/******** Scrollbars ********/
QScrollBar:vertical {
    width: 10px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    border: none;
    background: none;
}